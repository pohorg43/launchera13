.class public Lc1/e;
.super Lc1/a;
.source ""


# annotations
.annotation system Ldalvik/annotation/Signature;
    value = {
        "Lc1/a<",
        "Lc1/e;",
        ">;"
    }
.end annotation


# direct methods
.method public constructor <init>()V
    .registers 1

    invoke-direct {p0}, Lc1/a;-><init>()V

    return-void
.end method
